enum PlayGroundVisibility {
  PRIVATE
  PUBLIC
}

model PlayGround {
  id           String                 @id @default(cuid())
  name         String                 @map("name")
  visibility   PlayGroundVisibility   @default(PUBLIC) @map("visibility")
  description  String?                @map("description")
  locationLat  Float?                 @map("location_lat")
  locationLng  Float?                 @map("location_lng")
  locationAddr String?                @map("location_addr")
  users        PlayGroundUser[]
  inviteCodes  InviteCode[]
  rankinglist  PlayGroundRankingList?
  schedule     PlayGroundSchedule?
  createdAt    DateTime               @default(now()) @db.Timestamp(3)
  updatedAt    DateTime               @updatedAt @db.Timestamp(3)

  @@index([name], map: "idx_playground_name")
  @@map("playground")
}
