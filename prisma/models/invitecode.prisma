model InviteCode {
  id           String     @id @default(cuid())
  code         String     @unique @map("code")
  playGround   PlayGround @relation(fields: [playGroundId], references: [id], onDelete: Cascade, map: "invite_code_playground_id_fkey")
  playGroundId String
  createdBy    String     @map("created_by")
  maxUses      Int        @default(0) @map("max_uses")
  useCount     Int        @default(0) @map("use_count")
  expiresAt    DateTime?  @map("expires_at") @db.Timestamp(3)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @db.Timestamp(3)
  updatedAt    DateTime   @updatedAt @db.Timestamp(3)

  @@index([code], map: "idx_invite_code_code")
  @@index([playGroundId], map: "idx_invite_code_playground_id")
  @@map("invite_code")
}
