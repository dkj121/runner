enum RunStatus {
  ACTIVE
  PENDING_COMPLETION
  COMPLETED
}

model TotalRunRecord {
  id                      String   @id @default(cuid())
  user                    User     @relation(fields: [userId], references: [id], map: "total_run_record_user_id_fkey")
  userId                  String
  totalDurationSeconds    Int      @default(0) @map("total_duration_seconds")
  totalDistanceMeters     Float    @default(0) @map("total_distance_meters")
  averagePaceSecondsPerKm Int?     @map("average_pace_seconds_per_km")
  createdAt               DateTime @default(now()) @db.Timestamp(3)
  updatedAt               DateTime @updatedAt @db.Timestamp(3)

  @@unique([userId], name: "unique_total_run_record_user_id")
  @@index([userId], map: "idx_total_run_record_user_id")
  @@map("total_run_record")
}

model RunRecord {
  id                      String                 @id @default(cuid())
  user                    User                   @relation(fields: [userId], references: [id], map: "run_record_user_id_fkey")
  userId                  String
  playGroundRankingList   PlayGroundRankingList? @relation(fields: [playGroundRankingListId], references: [id], map: "run_record_playground_rankinglist_id_fkey")
  playGroundRankingListId String?
  startTime               DateTime
  endTime                 DateTime?
  status                  RunStatus              @default(ACTIVE)
  activeSessionOwnerId    String?                @unique(map: "unique_active_run_session_owner") @map("active_session_owner_id")
  durationSeconds         Int                    @default(0) @map("duration_seconds")
  distanceMeters          Float                  @default(0) @map("distance_meters")
  previewDistanceMeters   Float?                 @map("preview_distance_meters")
  paceSecondsPerKm        Int?                   @map("pace_seconds_per_km")
  trackPoints             Json?                  @map("track_points")
  calories                Int                    @default(0)
  splits                  Json?                  @map("splits")
  notes                   String?                @map("notes")
  createdAt               DateTime               @default(now()) @db.Timestamp(3)
  updatedAt               DateTime               @updatedAt @db.Timestamp(3)

  @@index([userId], map: "idx_run_record_user_id")
  @@index([playGroundRankingListId], map: "idx_run_record_playground_rankinglist_id")
  @@map("run_record")
}
