# Environment variables for Runner application
# Copy this file to .env and fill in your actual values

# Application
APP_NAME="runner"

# MySQL Database (Required)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="your_mysql_user"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_NAME="runner"
MYSQL_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_NAME}"

# Redis Cache (Required)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your_secure_redis_password"
REDIS_DB="0"
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# Redis ACL (Optional - for advanced Redis auth)
# REDIS_ACL_USER="your_redis_acl_user"
# REDIS_ACL_PASSWORD="your_redis_acl_password"

# Better Auth (Required)
# Generate secret: openssl rand -base64 32
# Or visit: https://better-auth.com/docs/installation
BETTER_AUTH_SECRET="your_32_char_or_longer_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"

# Resend Email Service (Required for email verification)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Runner <onboarding@resend.dev>"

# Amap (高德地图) API (Required)
NEXT_PUBLIC_AMAP_KEY="your_amap_key"
NEXT_PUBLIC_AMAP_SECURITY_CODE="your_amap_security_code"

# Docker-specific overrides (used by compose.yaml)
# When running with Docker, set REDIS_HOST=redis and MYSQL_HOST to your external DB host
